# ──────────────────────────────────────────────────────────────────────────────
# CRM Backend Environment Variables
# Copy this file to .env and update with your actual values
# ──────────────────────────────────────────────────────────────────────────────

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# MongoDB connection string for Mongoose
# Example for local MongoDB: mongodb://localhost:27017/crm_db
MONGO_URI=mongodb://localhost:27017/crm_db

# JWT Configuration
# Secret key for signing JWT tokens (use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# Token expiration time (example: "7d", "24h", "30d")
JWT_EXPIRES_IN=7d

# Frontend Configuration
# URL of the frontend application for CORS
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# Notes:
# ──────────────────────────────────────────────────────────────────────────────
# - In production, use strong JWT_SECRET and secure MONGO_URI
# - Never commit .env file to version control
# - Use environment-specific values for different deployment stages
# - CLIENT_URL should match your frontend's actual URL
